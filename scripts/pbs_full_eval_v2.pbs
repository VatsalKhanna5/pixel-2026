#!/bin/bash
#PBS -N pixel_eval_v2
#PBS -q workq
#PBS -l select=1:ncpus=16:ngpus=1:mem=64gb
#PBS -l walltime=08:00:00
#PBS -j oe
#PBS -o logs/pbs_full_eval_v2.log

cd "$PBS_O_WORKDIR"
source /apps/compilers/anaconda3/etc/profile.d/conda.sh
conda activate pixel-env
export PYTHONNOUSERSITE=1

# MIG auto-selection (same pattern as other jobs)
if [ -z "$CUDA_VISIBLE_DEVICES" ]; then
    FREE_MIG=$(python3 - << 'PYEOF'
import subprocess, re, sys
try:
    out = subprocess.check_output(['nvidia-smi', '-L'], text=True)
    mig_list = []; cur_gpu = None
    for line in out.splitlines():
        m = re.search(r'GPU \d+.*UUID: (GPU-[a-f0-9-]+)', line)
        if m: cur_gpu = m.group(1)
        mm = re.search(r'(MIG-[a-f0-9-]+)', line)
        if mm and cur_gpu and '1g.' not in line:
            mig_list.append((mm.group(1), cur_gpu))
    proc = subprocess.check_output(
        ['nvidia-smi','--query-compute-apps=gpu_uuid,used_memory','--format=csv,noheader'],
        text=True, stderr=subprocess.DEVNULL)
    busy = {}
    for ln in proc.strip().splitlines():
        if ln.strip():
            parts = ln.split(',')
            busy[parts[0].strip()] = busy.get(parts[0].strip(),0) + int(parts[1].strip().split()[0])
    for mig, gpu in mig_list:
        if busy.get(gpu, 0) < 10000:
            print(mig); sys.exit(0)
except: pass
PYEOF
)
    if [ -n "$FREE_MIG" ]; then
        export CUDA_VISIBLE_DEVICES="$FREE_MIG"
        echo "Selected free MIG: $FREE_MIG"
    fi
fi

# SIGTERM trap — resubmit if killed before completion
_resubmit() {
    echo "SIGTERM received — resubmitting …  $(date)"
    qsub "$PBS_O_WORKDIR/scripts/pbs_full_eval_v2.pbs"
    exit 0
}
trap '_resubmit' TERM

mkdir -p logs experiments/full_eval_v2 paper/figures data/tmp

echo "==== PIXEL-2026 Full Evaluation v2 (N=all test) ===="
echo "Job ID: $PBS_JOBID  GPU: $CUDA_VISIBLE_DEVICES  $(date)"
echo "====================================================="

python -m src.evaluation.full_eval \
    --config experiments/configs/base_config.yaml \
    --n-test -1 \
    --out-dir experiments/full_eval_v2 &
TRAIN_PID=$!
wait $TRAIN_PID
EXIT=$?

echo "full_eval exit: $EXIT  $(date)"

# Only generate figures if eval completed
if [ $EXIT -eq 0 ] && [ -f experiments/full_eval_v2/full_eval_summary.json ]; then
    python -m src.utils.visualization \
        --eval-dir experiments/full_eval_v2 \
        --out-dir paper/figures
fi

echo "End: $(date)  Exit: $EXIT"

# Resubmit if not complete
if [ $EXIT -ne 0 ] || [ ! -f experiments/full_eval_v2/full_eval_summary.json ]; then
    echo "Incomplete — resubmitting …"
    qsub "$PBS_O_WORKDIR/scripts/pbs_full_eval_v2.pbs"
fi
